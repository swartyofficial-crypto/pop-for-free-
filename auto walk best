-- 10 FLOATING IMAGES
local yuzerResimler = {}

local function yuzerResimOlustur(index)
    local resim = Instance.new("ImageLabel")
    resim.Name = "Float" .. index
    resim.Size = UDim2.new(0, 40 + math.random(20, 60), 0, 40 + math.random(20, 60))
    resim.Position = UDim2.new(
        math.random() * 1,
        math.random(-30, 30),
        math.random() * 1,
        math.random(-30, 30)
    )
    resim.BackgroundTransparency = 1
    resim.Image = RESIM
    resim.ImageColor3 = Color3.fromRGB(255, 255, 255)
    resim.ImageTransparency = 0.7 + math.random() * 0.2
    resim.ScaleType = Enum.ScaleType.Fit
    resim.ZIndex = 2
    resim.Rotation = math.random(-30, 30)
    resim.Parent = main

    local rCorner = Instance.new("UICorner")
    rCorner.CornerRadius = UDim.new(1, 0)
    rCorner.Parent = resim

    table.insert(yuzerResimler, {
        resim = resim,
        hiz = 0.5 + math.random() * 1.5,
        genlik = 15 + math.random() * 30,
        faz = math.random() * math.pi * 2,
        baslangicPoz = resim.Position,
        donmeHizi = (math.random() - 0.5) * 3,
        baslangicRot = resim.Rotation,
    })
end

for i = 1, 10 do
    yuzerResimOlustur(i)
end

task.spawn(function()
    local t = 0
    while gui.Parent do
        t = t + 0.03
        for _, veri in ipairs(yuzerResimler) do
            if veri.resim.Parent then
                local xOff = math.sin(t * veri.hiz + veri.faz) * veri.genlik
                local yOff = math.cos(t * veri.hiz * 0.8 + veri.faz) * veri.genlik
                veri.resim.Position = UDim2.new(
                    veri.baslangicPoz.X.Scale,
                    veri.baslangicPoz.X.Offset + xOff,
                    veri.baslangicPoz.Y.Scale,
                    veri.baslangicPoz.Y.Offset + yOff
                )
                veri.resim.Rotation = veri.baslangicRot + math.sin(t * veri.donmeHizi) * 20
            end
        end
        task.wait(0.03)
    end
end)

