local function mainPartKontrol()
    local mainPart = workspace:FindFirstChild("MainPart")
    if not mainPart then return false end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local mesafe = (part.Position - mainPart.Position).Magnitude
            local temasMesafesi = (part.Size.Magnitude / 2) + (mainPart.Size.Magnitude / 2) + 2
            if mesafe < temasMesafesi then
                return true
            end
        end
    end
    return false
end

-- STATUS
local function setStatus(txt, color)
    statusText.Text = txt
    statusDot.BackgroundColor3 = color
end

-- WALK LOGIC
local function durdur()
    hum:MoveTo(hrp.Position)
    hum:Move(Vector3.zero, false)
end

local function yuru()
    while getgenv().calisiyor do
        if not char.Parent or hum.Health <= 0 then break end

        while char.Parent and hum.Health > 0 and getgenv().calisiyor do
            if (hrp.Position - baslangic).Magnitude < 3 then break end
            hum:MoveTo(baslangic)
            task.wait(0.1)
        end

        if not getgenv().calisiyor then break end

        local yurumeDevam = true
        local mainPartDegdi = false

        task.spawn(function()
            while yurumeDevam and getgenv().calisiyor do
                if not char.Parent or hum.Health <= 0 then break end
                if (hrp.Position - bitis).Magnitude < 3 then break end
                hum:MoveTo(bitis)
                task.wait(0.1)
            end
        end)

        local beklemeSayaci = 0
        while beklemeSayaci < 5 and yurumeDevam and getgenv().calisiyor do
            task.wait(0.5)
            beklemeSayaci = beklemeSayaci + 0.5
        end

        if not getgenv().calisiyor then break end

        while yurumeDevam and getgenv().calisiyor do
            if not char.Parent or hum.Health <= 0 then break end

            if mainPartKontrol() then
                mainPartDegdi = true
                yurumeDevam = false
                break
            end

            if (hrp.Position - bitis).Magnitude < 3 then break end
            task.wait(0.2)
        end

        if not getgenv().calisiyor then break end

        task.wait(0.3)
    end
end

