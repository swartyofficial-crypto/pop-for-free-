-- TOUCH TRIGGER
-- ============================================
local tetikleyici = workspace:FindFirstChild("3d1a6fb4-dab3-4856-8718-c2ba2c7bc26b", true)
if tetikleyici then
    tetikleyici.Touched:Connect(function(hit)
        if hit.Parent == char then
            getgenv().calisiyor = false
            durdur()
            task.wait(0.2)
            getgenv().calisiyor = true
            updateStatus("Triggered, restarting...", Color3.fromRGB(0, 200, 255))
            task.spawn(yuru)
        end
    end)
else
    warn("[AutoWalk] Trigger part not found.")
end

