local function makeButton(text, posX, widthScale, renk)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(widthScale, -18, 0, 38)
    b.Position = UDim2.new(0, posX, 0, 100)
    b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    b.Text = ""
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.ClipsDescendants = true
    b.ZIndex = 9
    b.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = b

    -- Arka plan resmi
    local bgImg = Instance.new("ImageLabel")
    bgImg.Name = "BgImg"
    bgImg.Size = UDim2.new(1, 0, 1, 0)
    bgImg.Position = UDim2.new(0, 0, 0, 0)
    bgImg.BackgroundTransparency = 1
    bgImg.Image = BUTON_RESIM
    bgImg.ImageColor3 = renk
    bgImg.ScaleType = Enum.ScaleType.Crop
    bgImg.ZIndex = 9
    bgImg.ClipsDescendants = true
    bgImg.Parent = b

    local bgImgCorner = Instance.new("UICorner")
    bgImgCorner.CornerRadius = UDim.new(0, 10)
    bgImgCorner.Parent = bgImg

    -- Koyu katman (yazı okunsun)
    local overlay2 = Instance.new("Frame")
    overlay2.Size = UDim2.new(1, 0, 1, 0)
    overlay2.BackgroundColor3 = renk
    overlay2.BackgroundTransparency = 0.5
    overlay2.BorderSizePixel = 0
    overlay2.ZIndex = 9
    overlay2.Parent = b

    local ov2Corner = Instance.new("UICorner")
    ov2Corner.CornerRadius = UDim.new(0, 10)
    ov2Corner.Parent = overlay2

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.7
    stroke.Thickness = 1
    stroke.Parent = b

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.ZIndex = 10
    lbl.Parent = b

    local lblShadow = Instance.new("UIStroke")
    lblShadow.Color = Color3.fromRGB(0, 0, 0)
    lblShadow.Transparency = 0.4
    lblShadow.Thickness = 1
    lblShadow.Parent = lbl

    b.MouseEnter:Connect(function()
        b.Size = UDim2.new(widthScale, -16, 0, 40)
        b.Position = UDim2.new(0, posX + 1, 0, 99)
        bgImg.ImageColor3 = Color3.fromRGB(
            math.min(255, renk.R * 255 + 50),
            math.min(255, renk.G * 255 + 50),
            math.min(255, renk.B * 255 + 50)
        )
    end)
    b.MouseLeave:Connect(function()
        b.Size = UDim2.new(widthScale, -18, 0, 38)
        b.Position = UDim2.new(0, posX, 0, 100)
        bgImg.ImageColor3 = renk
    end)

    return b, lbl, bgImg, overlay2
end

