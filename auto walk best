local function fountainSil()
    local anaModel = workspace:FindFirstChild("Better Low Poly Fountain")
    if anaModel then
        local fountain = anaModel:FindFirstChild("Fountain")
        if fountain then
            fountain:Destroy()
            print("[AutoWalk] Better Low Poly Fountain > Fountain silindi.")
            return
        end
        -- Fountain alt elemanı yoksa, modelin kendisini sil
        anaModel:Destroy()
        print("[AutoWalk] Better Low Poly Fountain (tam model) silindi.")
        return
    end

    -- Recursive ara
    local bulundu = workspace:FindFirstChild("Fountain", true)
    if bulundu then
        bulundu:Destroy()
        print("[AutoWalk] Fountain (recursive) silindi.")
        return
    end

    warn("[AutoWalk] Fountain bulunamadı.")
end

