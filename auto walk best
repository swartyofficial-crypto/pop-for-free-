-- ============================================
-- WALK LOGIC
-- ============================================
local function updateStatus(txt, color)
    statusText.Text = txt
    statusDot.BackgroundColor3 = color
end

local function durdur()
    hum:MoveTo(hrp.Position)
    hum:Move(Vector3.zero, false)
end

local function yuru()
    if not getgenv().calisiyor then return end

    updateStatus("Walking to start...", Color3.fromRGB(255, 200, 0))
    while char.Parent and hum.Health > 0 and getgenv().calisiyor do
        if (hrp.Position - baslangic).Magnitude < 3 then break end
        hum:MoveTo(baslangic)
        task.wait(0.1)
    end

    if not getgenv().calisiyor then return end

    updateStatus("Walking to finish...", Color3.fromRGB(0, 200, 255))
    while char.Parent and hum.Health > 0 and getgenv().calisiyor do
        if (hrp.Position - bitis).Magnitude < 3 then break end
        hum:MoveTo(bitis)
        task.wait(0.1)
    end

    if getgenv().calisiyor and (hrp.Position - bitis).Magnitude < 3 then
        updateStatus("Finished!", Color3.fromRGB(0, 255, 120))
    end
end

